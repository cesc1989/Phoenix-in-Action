<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <img src={~p"/images/logo.svg"} width="36" />
      </a>

      <p class="bg-brand/5 text-brand rounded-full px-2 font-medium leading-6">
        v<%= Application.spec(:phoenix, :vsn) %>
      </p>
    </div>

    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <a
        href="https://hexdocs.pm/phoenix/overview.html"
        class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
      >
        Get Started <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</header>

<div class="container" style="border-bottom: 1px solid #777777; margin-bottom: 2rem; padding-bottom: 1rem;">
  <%!-- link "Items", to: ~p"/items" --%>
  <.link href={~p"/items"}>
    Items
  </.link>
  |
  <%= if @current_user do %>
    <%!-- Logged in as <%= link @current_user.username, to: ~p"/users/#{@current_user}" %> --%>
    Logged in as
    <.link href={~p"/users/#{@current_user}"}>
      <%= @current_user.username %>
    </.link>
    |
    <%!-- <%= link "Log out", to: ~p"/logout" %> --%>
    <.link href={~p"/logout"} method="delete">Log out</.link>
  <% else %>
    <%!-- <%= link "login", to: ~p"/login" %> --%>
    <.link href={~p"/login"}>Login</.link>
  <% end %>
</div>

<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />

    <%= @inner_content %>
  </div>
</main>
